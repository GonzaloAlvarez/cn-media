# cn-media — Jellyfin on kaiser.lan, dual-ingress jellyfin.lan + jellyfin.lab.gn.al.

# Repo-wide identifiers (match cn-bittorrent's .env)
HEADSCALE_DOMAIN=hs.gn.al
LAB_DOMAIN=lab.gn.al
TAILNET_DOMAIN=ts.gn.al
INFRA_VPS_TAILNET_IP=100.64.0.1

# Tailscale auth key for ts-jellyfin (tag:svc, 24h expiration).
# Mint via:
#   ssh hs.gn.al 'docker exec cloudnet-headscale-1 \
#     headscale preauthkeys create -u 2 --tags tag:svc --expiration 24h'
# (-u 2 is gonzaloab@gmail.com's numeric user ID; verify with `headscale users list`)
MEDIA_AUTHKEY=

# Container UID/GID for /config ownership + /dev/dri group_add
USER_ID=1000
GROUP_ID=1000
TIMEZONE=America/Los_Angeles
