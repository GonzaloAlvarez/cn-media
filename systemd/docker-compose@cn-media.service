[Unit]
Description=cn-media docker compose stack (jellyfin + future media services)
Requires=docker.service home-gonzalo-docker-data-nfs.mount
# Serial start ordering with sibling stacks on this host: cn-bittorrent ->
# cn-media -> cn-roms. Three docker-compose@ units all touch the docker
# socket and the in-stack watchdog runs `docker compose up` concurrently;
# parallel-firing after boot races the watchdog/compose pairs into name
# conflicts. Sequential After= ordering eliminates the parallel trigger
# (it's ordering only, not a dependency — cn-media still starts if
# cn-bittorrent fails).
After=docker.service home-gonzalo-docker-data-nfs.mount network-online.target docker-compose@cn-bittorrent.service
RequiresMountsFor=/home/gonzalo/docker/data/nfs
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=gonzalo
Group=gonzalo
WorkingDirectory=/home/gonzalo/cn-media
Environment="PWD=/home/gonzalo/cn-media"
ExecStartPre=/usr/bin/mountpoint -q /home/gonzalo/docker/data/nfs
ExecStart=/usr/bin/docker compose -p cn-media up -d --remove-orphans
ExecStop=/usr/bin/docker compose -p cn-media down

[Install]
WantedBy=multi-user.target
